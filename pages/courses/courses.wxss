/* pages/courses/courses.wxss
   1:1 翻译 H5 styles.css 中课程目录屏相关样式。
   小程序单位用 rpx：750rpx = 设计稿宽度。H5 设计宽度约 390px，
   换算系数 750/390 ≈ 1.923。为视觉精确，关键尺寸按 px×2 近似（rpx），
   并保留 H5 原值于注释中以便核对。
*/

/* —— 品牌头 brand-header（H5 flex:0 0 59px）—— */
.brand-header {
  flex: 0 0 118rpx;
  min-height: 118rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 0 36rpx;
  border-bottom: 1rpx solid var(--line);
  background: rgba(255, 255, 255, 0.98);
  z-index: 5;
}

.brand-lockup,
.header-directory {
  display: flex;
  align-items: center;
}

.brand-lockup {
  min-width: 0;
  gap: 16rpx;
}

.brand-mark-crop {
  width: 92rpx;
  height: 50rpx;
  overflow: hidden;
  display: block;
  flex: 0 0 auto;
}

.brand-mark-crop image {
  display: block;
  width: auto;
  height: 50rpx;
}

.brand-copy {
  display: flex;
  align-items: center;
  min-width: 0;
  white-space: nowrap;
  color: var(--ink);
}

.brand-name {
  font-size: 30rpx;
  font-weight: 750;
}

.brand-divider {
  width: 2rpx;
  height: 32rpx;
  background: #b7bdc6;
  margin: 0 14rpx;
}

.brand-station {
  font-size: 26rpx;
  font-weight: 650;
}

.header-progress-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 20rpx;
  background: #f0f4ff;
  border-radius: 28rpx;
  color: #286be6;
  font-size: 24rpx;
  white-space: nowrap;
}

.header-progress-icon {
  font-size: 26rpx;
}

/* —— 介绍区 directory-intro（H5 padding 28 20 20）—— */
.directory-intro {
  padding: 56rpx 40rpx 40rpx;
  display: flex;
  flex-direction: column;
}

.eyebrow {
  margin: 0 0 16rpx;
  color: var(--blue);
  font-size: 24rpx;
  font-weight: 720;
}

/* 介绍区首行：eyebrow 居左，学习进度按钮居右，同一水平线 */
.intro-top-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin: 0 0 16rpx;
}

.intro-top-row .eyebrow {
  margin: 0;
}

.directory-title {
  max-width: 580rpx;
  font-size: 52rpx;
  line-height: 1.28;
  font-weight: 740;
}

.directory-desc {
  margin-top: 22rpx;
  color: var(--muted);
  font-size: 26rpx;
  line-height: 1.65;
}

/* —— 搜索框 search-box（H5 height 44）—— */
.search-box {
  height: 88rpx;
  margin: 0 40rpx 42rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 0 24rpx;
  color: #6f7785;
  border: 1rpx solid #d9dee5;
  border-radius: 12rpx;
  background: #f8f9fa;
}

.search-icon {
  font-size: 30rpx;
}

.search-input {
  min-width: 0;
  flex: 1;
  color: var(--ink);
  font-size: 28rpx;
}

.search-placeholder {
  color: #9aa0aa;
}

.search-clear {
  width: 52rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #7c8490;
  font-size: 24rpx;
}

/* —— 课程区 course-section（H5 padding 0 20 26）—— */
.course-section {
  padding: 0 40rpx 52rpx;
}

.section-heading-line {
  min-height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 710;
}

.section-count {
  color: #969ca6;
  font-size: 22rpx;
}

.course-list {
  border-top: 1rpx solid var(--line);
}

.course-row {
  width: 100%;
  min-height: 196rpx;
  display: grid;
  grid-template-columns: 50rpx 84rpx minmax(0, 1fr) 36rpx;
  align-items: center;
  gap: 20rpx;
  padding: 30rpx 0;
  border-bottom: 1rpx solid var(--line);
  text-align: left;
  background: #fff;
}

.course-row-hover {
  background: #f8fafc;
}

.course-index {
  color: #a0a6b0;
  font-size: 20rpx;
}

.course-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 80rpx;
  height: 80rpx;
  border-radius: 12rpx;
  font-size: 40rpx;
}

/* tone 配色：与 H5 一致 */
.tone-blue .course-icon { color: var(--blue); background: var(--blue-soft); }
.tone-green .course-icon { color: var(--green); background: var(--green-soft); }
.tone-coral .course-icon { color: var(--coral); background: var(--coral-soft); }
.tone-yellow .course-icon { color: #9f7600; background: var(--yellow-soft); }

.course-copy {
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.course-title-text {
  font-size: 32rpx;
  line-height: 1.35;
  font-weight: 650;
}

.course-subject {
  margin-top: 6rpx;
  color: var(--blue);
  font-size: 22rpx;
}

.course-desc {
  margin-top: 8rpx;
  color: var(--muted);
  font-size: 22rpx;
  line-height: 1.5;
}

.row-caret {
  color: #a4aab3;
  font-size: 32rpx;
}

/* —— 空状态 empty-state —— */
.empty-state {
  min-height: 340rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  color: #9299a5;
}

.empty-icon {
  font-size: 56rpx;
}

.empty-title {
  margin-top: 10rpx;
  color: #555c68;
  font-size: 28rpx;
}

.empty-desc {
  font-size: 24rpx;
}

/* —— 加载/错误状态 —— */
.state-block {
  padding: 100rpx 40rpx; text-align: center; color: #969ca6; font-size: 26rpx;
}
.state-block.error .state-title { display: block; color: #ed5d59; margin-bottom: 24rpx; }
.state-btn {
  display: inline-block; padding: 16rpx 36rpx; background: #286be6;
  color: #fff; border-radius: 10rpx; font-size: 26rpx;
}

/* focus 高亮（从学习进度跳来时提示用户点哪门课）*/
.course-row.highlighted {
  background: #f0f4ff;
  border-left: 6rpx solid #286be6;
  padding-left: 16rpx;
  animation: pulse 1s ease-in-out 2;
}
@keyframes pulse {
  0%, 100% { background: #f0f4ff; }
  50% { background: #e0eaff; }
}
