<!-- pages/courses/courses.wxml
     对应 H5 的 CourseDirectory 组件（App.jsx:82-134）
     结构：品牌头 -> 介绍区 -> 搜索框 -> 课程列表
-->
<view class="screen screen-directory">

  <!-- 状态栏占位（避免内容顶到系统状态栏）-->
  <view class="status-bar-holder" style="height: {{statusBarHeight}}px;"></view>

  <!-- 品牌头 BrandHeader（compact=false） -->
  <view class="brand-header">
    <view class="brand-lockup">
      <view class="brand-mark-crop">
        <image src="/images/swxx-brand-mark.png" mode="heightFix" />
      </view>
      <view class="brand-copy">
        <text class="brand-name">三五小星</text>
        <text class="brand-divider"></text>
        <text class="brand-station">知识成果检测站</text>
      </view>
    </view>
    <view class="header-actions" style="margin-right: {{headerRightInset}}px;">
      <view class="header-progress-btn" bindtap="onGoProgress">
        <text class="header-progress-icon">📊</text>
        <text>学习进度</text>
      </view>
    </view>
  </view>

  <scroll-view class="screen-scroll" scroll-y>

    <!-- 介绍区 directory-intro -->
    <view class="directory-intro">
      <text class="eyebrow">家长课后手册</text>
      <text class="directory-title">选择孩子刚学完的课程</text>
      <text class="directory-desc">先找到课程，再进入对应集数查看重点与核心问题。</text>
    </view>

    <!-- 搜索框 SearchBox -->
    <view class="search-box">
      <text class="search-icon">🔍</text>
      <input
        class="search-input"
        value="{{query}}"
        bindinput="onQueryChange"
        placeholder="搜索课程或学科"
        placeholder-class="search-placeholder"
      />
      <view wx:if="{{query}}" class="search-clear" bindtap="onClearQuery">
        <text>✕</text>
      </view>
    </view>

    <!-- 课程列表 course-section -->
    <view wx:if="{{loading}}" class="state-block">
      <text>正在加载课程...</text>
    </view>
    <view wx:elif="{{errMsg}}" class="state-block error">
      <text class="state-title">{{errMsg}}</text>
      <view class="state-btn" bindtap="loadCatalog">重新加载</view>
    </view>
    <view wx:else class="course-section">
      <view class="section-heading-line">
        <text class="section-title">全部课程</text>
        <text class="section-count">{{filteredCourses.length}} 个系列</text>
      </view>

      <view class="course-list">
        <view
          wx:for="{{filteredCourses}}"
          wx:key="id"
          class="course-row tone-{{item.accent}} {{item.highlighted ? 'highlighted' : ''}}"
          bindtap="onSelectCourse"
          data-course="{{item}}"
          hover-class="course-row-hover"
        >
          <text class="course-index">{{item.indexLabel}}</text>
          <view class="course-icon">
            <text class="course-icon-glyph">{{item.iconGlyph}}</text>
          </view>
          <view class="course-copy">
            <text class="course-title-text">{{item.title}}</text>
            <text class="course-subject">{{item.subject}} · {{item.count}} 集</text>
            <text class="course-desc">{{item.description}}</text>
          </view>
          <text class="row-caret">›</text>
        </view>
      </view>

      <!-- 空状态 EmptyState -->
      <view wx:if="{{filteredCourses.length === 0}}" class="empty-state">
        <text class="empty-icon">🔍</text>
        <text class="empty-title">没有找到这个课程</text>
        <text class="empty-desc">换一个关键词再试试</text>
      </view>
    </view>

  </scroll-view>
</view>
