/* pages/bindChild/bindChild.wxss */
.bind-screen { background: #f5f6f8; min-height: 100vh; }

.bind-topbar {
  flex: 0 0 96rpx; min-height: 96rpx; display: flex;
  align-items: center; justify-content: space-between;
  padding: 0 36rpx; background: #fff;
  border-bottom: 1rpx solid var(--line);
}
.topbar-title { font-size: 32rpx; font-weight: 700; color: #1a1f2e; }
.topbar-logout { font-size: 26rpx; color: #969ca6; }

.bind-scroll { min-height: 0; flex: 1; padding: 30rpx 0; }

/* —— 加载/错误状态 —— */
.loading-state {
  padding: 120rpx 40rpx; text-align: center; color: #969ca6; font-size: 26rpx;
}
.err-card {
  margin: 60rpx 36rpx; padding: 50rpx 36rpx; background: #fff;
  border-radius: 16rpx; text-align: center;
}
.err-card-title { display: block; font-size: 30rpx; color: #ed5d59; font-weight: 600; }
.err-card-msg { display: block; margin: 16rpx 0 28rpx; font-size: 24rpx; color: #6d7482; }
.err-card-btn {
  display: inline-block; padding: 16rpx 36rpx; background: #286be6;
  color: #fff; border-radius: 10rpx; font-size: 26rpx;
}

/* —— 旧的手动查询卡片样式已废弃（登录号自动查询）—— */

/* —— 进度展示 —— */
.progress-wrap { padding: 0 36rpx; }

.child-card {
  display: flex; align-items: center; gap: 24rpx;
  padding: 28rpx 32rpx; background: #fff; border-radius: 16rpx;
  margin-bottom: 24rpx; box-shadow: 0 4rpx 20rpx rgba(20,27,37,0.05);
}
.child-avatar {
  width: 88rpx; height: 88rpx; border-radius: 50%;
  background: #f0f4ff; color: #286be6; font-size: 40rpx; font-weight: 700;
  display: flex; align-items: center; justify-content: center;
}
.child-info { display: flex; flex-direction: column; }
.child-name { font-size: 32rpx; font-weight: 650; color: #1a1f2e; }
.child-meta { margin-top: 6rpx; font-size: 22rpx; color: #969ca6; }

.course-progress-list { display: flex; flex-direction: column; gap: 18rpx; }
.course-progress {
  padding: 28rpx 32rpx; background: #fff; border-radius: 14rpx;
  border-left: 8rpx solid var(--blue);
  box-shadow: 0 2rpx 12rpx rgba(20,27,37,0.04);
}
.course-progress.tone-blue { border-left-color: #286be6; }
.course-progress.tone-green { border-left-color: #1da86b; }
.course-progress.tone-yellow { border-left-color: #f2c736; }
.course-progress.tone-coral { border-left-color: #ed5d59; }

.cp-head { display: flex; justify-content: space-between; align-items: center; }
.cp-name { font-size: 30rpx; font-weight: 650; color: #1a1f2e; }
.cp-go { font-size: 24rpx; color: #286be6; }

.cp-bar-wrap {
  margin: 18rpx 0 12rpx; height: 12rpx; background: #f0f2f5; border-radius: 6rpx; overflow: hidden;
}
.cp-bar { height: 100%; background: #286be6; border-radius: 6rpx; transition: width .3s; }
.tone-blue .cp-bar { background: #286be6; }
.tone-green .cp-bar { background: #1da86b; }
.tone-yellow .cp-bar { background: #f2c736; }
.tone-coral .cp-bar { background: #ed5d59; }

.cp-stat { display: flex; gap: 28rpx; }
.cp-stat text { font-size: 22rpx; color: #6d7482; }

.requery-btn {
  margin: 36rpx 0; text-align: center; padding: 20rpx;
  font-size: 26rpx; color: #6d7482;
}

/* 顶栏返回按钮 */
.topbar-back {
  display: flex; align-items: center; gap: 8rpx;
  color: #286be6; font-size: 26rpx;
}
.topbar-back-arrow { font-size: 32rpx; }

/* 数据说明 */
.progress-note {
  margin: 0 8rpx 48rpx;
  text-align: center;
  font-size: 22rpx;
  line-height: 1.6;
  color: #9aa1ad;
}
