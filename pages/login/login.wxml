<!-- pages/login/login.wxml
     家长登录页：手机号 + 短信验证码
     注意：这里输的是【家长的】手机号，用于登录身份。
     登录后还要在"绑定孩子"页输入【孩子的】手机号才能查进度。
-->
<view class="screen login-screen">
  <view class="status-bar-holder" style="height: {{statusBarHeight}}px;"></view>

  <scroll-view class="login-scroll" scroll-y>
    <view class="login-brand">
      <image class="login-logo" src="/images/swxx-brand-mark.png" mode="heightFix" />
    </view>

    <view class="login-head">
      <text class="login-title">三五小星知识成果检测站</text>
      <text class="login-sub">家长登录 · 查看孩子的学习进度</text>
    </view>

    <view class="login-form">
      <view class="form-row">
        <text class="form-label">手机号</text>
        <view class="phone-input-wrap">
          <input
            class="phone-input"
            type="number"
            maxlength="11"
            value="{{phone}}"
            bindinput="onPhoneInput"
            placeholder="请输入家长手机号"
            placeholder-class="ph"
          />
        </view>
      </view>

      <view class="form-row">
        <text class="form-label">验证码</text>
        <view class="code-row">
          <input
            class="code-input"
            type="number"
            maxlength="6"
            value="{{code}}"
            bindinput="onCodeInput"
            placeholder="6位验证码"
            placeholder-class="ph"
          />
          <view
            class="send-btn {{countingDown ? 'is-disabled' : ''}}"
            bindtap="onSendCode"
          >{{countingDown ? countdownText : '获取验证码'}}</view>
        </view>
      </view>

      <button class="login-btn" bindtap="onLogin" loading="{{loading}}">登录</button>

      <text wx:if="{{errMsg}}" class="err-text">{{errMsg}}</text>
    </view>

    <view class="login-foot">
      <text>登录即表示您是孩子的家长，仅用于查看孩子在本平台的学习进度。</text>
    </view>
  </scroll-view>
</view>
